# Never commit real credentials. Real mode also requires an explicit CLI budget.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
AUTOPILOT_CONFIG=config/default.yaml
AUTOPILOT_DATABASE_URL=sqlite:///data/autopilot.db
# Optional internal bearer token for clients calling this FastAPI service.
# Generate it yourself (for example with `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# It is not issued by OpenRouter or TypeSafe and may stay empty on localhost.
AUTOPILOT_API_KEY=
